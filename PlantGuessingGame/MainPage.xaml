<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PlantGuessingGame.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PlantGuessingGame"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:PlantGuessingGame.DataModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Header with Sort button and ComboBox -->
            <RowDefinition Height="*" />
            <!-- ListView -->
            <RowDefinition Height="Auto" />
            <!-- Bottom buttons -->
        </Grid.RowDefinitions>

        <!-- Header: Title and horizontal panel with Sort left, ComboBox right -->
        <StackPanel Grid.Row="0">
            <!-- Title row -->
            <StackPanel Orientation="Horizontal">
                <SymbolIcon Margin="8" Symbol="Home" />
                <TextBlock
                    Margin="8"
                    Style="{StaticResource SubheaderTextBlockStyle}"
                    Text="The Plant Guessing Game" />
            </StackPanel>

            <!-- Sort button left, ComboBox right on the same horizontal line -->
            <Grid HorizontalAlignment="Stretch" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Content="Sort" Width="150" Margin="8,0" VerticalAlignment="Center" Grid.Column="0" Command="{x:Bind ViewModel.SortPlantListCommand}" />

                <!-- Spacer -->
                <StackPanel Grid.Column="1" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock
                        Margin="4"
                        VerticalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Plant Type: " />

                    <ComboBox
                        Width="120"
                        Margin="0,2,6,4"
                        VerticalAlignment="Center"
                        ItemsSource="{x:Bind ViewModel.PlantTypes}"
                        SelectedItem="{x:Bind ViewModel.SelectedPlantType, Mode=TwoWay}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- ListView showing plants -->
        <ListView
            Grid.Row="1"
            DoubleTapped="{x:Bind ViewModel.ListViewDoubleTapped}"
            ItemsSource="{x:Bind ViewModel.Plants}"
            SelectedItem="{x:Bind ViewModel.SelectedPlant, Mode=TwoWay}">

            <ListView.HeaderTemplate>
                <DataTemplate>
                    <Grid Margin="4,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border BorderBrush="{ThemeResource SystemAccentColor}" BorderThickness="0,0,0,2">
                            <TextBlock
                                Margin="4,0,0,0"
                                Style="{StaticResource TitleTextBlockStyle}"
                                Text="Common Name" />
                        </Border>

                        <Border
                            Grid.Column="1"
                            BorderBrush="{ThemeResource SystemAccentColor}"
                            BorderThickness="0,0,0,2">
                            <TextBlock
                                Margin="4,0,0,0"
                                Style="{StaticResource TitleTextBlockStyle}"
                                Text="Family Name" />
                        </Border>

                        <Border
                            Grid.Column="2"
                            BorderBrush="{ThemeResource SystemAccentColor}"
                            BorderThickness="0,0,0,2">
                            <TextBlock
                                Margin="4,0,0,0"
                                Style="{StaticResource TitleTextBlockStyle}"
                                Text="Genus" />
                        </Border>

                        <Border
                            Grid.Column="3"
                            BorderBrush="{ThemeResource SystemAccentColor}"
                            BorderThickness="0,0,0,2">
                            <TextBlock
                                Margin="4,0,0,0"
                                Style="{StaticResource TitleTextBlockStyle}"
                                Text="Species" />
                        </Border>

                        <Border
                            Grid.Column="4"
                            BorderBrush="{ThemeResource SystemAccentColor}"
                            BorderThickness="0,0,0,2">
                            <TextBlock
                                Margin="4,0,0,0"
                                Style="{StaticResource TitleTextBlockStyle}"
                                Text="Description" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.HeaderTemplate>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="model:Plant">
                    <Grid IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{x:Bind CommonName}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Family}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Genus}" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Species}" />
                        <TextBlock Grid.Column="4" Text="{x:Bind Description}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Bottom buttons -->
        <Border
            Grid.Row="2"
            Margin="4,0"
            BorderBrush="{ThemeResource SystemAccentColor}"
            BorderThickness="0,2,0,0">
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Margin="8,8,0,8"
                    Command="{x:Bind ViewModel.AddEditCommand}"
                    Content="Add/Edit Plant" />
                <Button
                    Margin="8"
                    Command="{x:Bind ViewModel.DeleteCommand}"
                    Content="Delete Plant" />
            </StackPanel>
        </Border>

    </Grid>

</Page>
