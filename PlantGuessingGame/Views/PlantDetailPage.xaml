<Page
    x:Class="PlantGuessingGame.Views.PlantDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PlantGuessingGame.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:PlantGuessingGame.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">


    <Page.Resources>
        <Style x:Key="AttributeTitleStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="AttributeValueStyle" TargetType="TextBox">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="8" />
        </Style>
        <Style x:Key="AttributeComboxValueStyle" TargetType="ComboBox">
            <!--<Setter Property="HorizontalAlignment" Value="Stretch" />c:\users\jordycoffa\source\repos\plantguessinggame\plantguessinggame\views\plantdetailpage.xaml.cs
c:\users\jordycoffa\source\repos\plantguessinggame\plantguessinggame\views\plantdetailpage.xaml

            <Setter Property="Margin" Value="8" />-->
        </Style>
    </Page.Resources>



    <!--  NOTE: If we add a scroll bar here on auto we have the scrolling ability over the whole page or "outer grid"  -->
    <ScrollViewer HorizontalScrollBarVisibility="auto" VerticalScrollBarVisibility="auto">


        <!--  row 0: title for page in a stackpanel with a symbol icon and a textblock  -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">


            <!--  grid to divide page  -->
            <Grid Margin="10">

                <!--  divide page into 3 rows  -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--
                    Note; if we add a column setup here we can limit the length, if we dont the column will space out by content, e.g. description, so by limiting description may become a word wrap
                    this wwould also allow spacing in a second column for e.g. a picture or listivew with pictures
                -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="800" />
                    <!--  second column we can add the images  -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>


                <!--  row 0: title for page in a stackpanel with a symbol icon and a textblock  -->
                <StackPanel Grid.Row="0" Orientation="Horizontal">

                    <SymbolIcon Margin="8" Symbol="Edit" />
                    <TextBlock
                        Margin="8"
                        Style="{StaticResource SubheaderTextBlockStyle}"
                        Text="General Information" />

                </StackPanel>


                <!--  split the second part of the page in two more sections (general info and details))  -->
                <StackPanel Grid.Row="1" Orientation="Vertical">


                    <!--  GRID1: Plant general info  -->
                    <Grid
                        Margin="4,0,4,8"
                        BorderBrush="{ThemeResource SystemAccentColor}"
                        BorderThickness="0,1,0,1"
                        IsHitTestVisible="True">


                        <!--  grid definitions for the details of the selected plant  -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  2 columns per item (title and field)  -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  name in local language  -->
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource DefaultTextBoxStyle}"
                            Text="Local Name:" />
                        <TextBox
                            Grid.Column="1"
                            Style="{StaticResource AttributeValueStyle}"
                            Text="{x:Bind ViewModel.ItemLocalName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!--  commons name - note that these have update source triggers via the bindable base  -->
                        <TextBlock
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource DefaultTextBoxStyle}"
                            Text="Common Name:" />
                        <TextBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource AttributeValueStyle}"
                            Text="{x:Bind ViewModel.ItemCommonName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!--  genus  -->
                        <TextBlock
                            Grid.Row="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource DefaultTextBoxStyle}"
                            Text="Genus:" />
                        <TextBox
                            Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource AttributeValueStyle}"
                            Text="{x:Bind ViewModel.ItemGenus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!--  species  -->
                        <TextBlock
                            Grid.Row="3"
                            VerticalAlignment="Center"
                            Style="{StaticResource DefaultTextBoxStyle}"
                            Text="Species:" />
                        <TextBox
                            Grid.Row="3"
                            Grid.Column="1"
                            Style="{StaticResource AttributeValueStyle}"
                            Text="{x:Bind ViewModel.ItemSpecies, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!--  family  -->
                        <TextBlock
                            Grid.Row="4"
                            VerticalAlignment="Center"
                            Style="{StaticResource DefaultTextBoxStyle}"
                            Text="Family:" />
                        <TextBox
                            Grid.Row="4"
                            Grid.Column="1"
                            Style="{StaticResource AttributeValueStyle}"
                            Text="{x:Bind ViewModel.ItemFamily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!--  description  -->
                        <TextBlock
                            Grid.Row="5"
                            VerticalAlignment="Center"
                            Style="{StaticResource DefaultTextBoxStyle}"
                            Text="Description:"
                            TextWrapping="Wrap" />
                        <TextBox
                            Grid.Row="5"
                            Grid.Column="1"
                            Style="{StaticResource AttributeValueStyle}"
                            Text="{x:Bind ViewModel.ItemDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />

                        <!--  plant type: Note links to an observeable collection and a selected type that has a set property  -->
                        <!--  Style: note that the style AttributeComboxValueStyle needs to be available in the resources, page or app wide  -->
                        <TextBlock
                            Grid.Row="6"
                            VerticalAlignment="Center"
                            Style="{StaticResource DefaultTextBoxStyle}"
                            Text="Type:" />
                        <ComboBox
                            Grid.Row="6"
                            Grid.Column="1"
                            ItemsSource="{x:Bind ViewModel.PlantTypes}"
                            SelectedValue="{x:Bind ViewModel.SelectedPlantType, Mode=TwoWay}"
                            Style="{StaticResource AttributeComboxValueStyle}" />


                        <!--  Plant Classification  -->
                        <TextBlock
                            Grid.Row="7"
                            VerticalAlignment="Center"
                            Style="{StaticResource DefaultTextBoxStyle}"
                            Text="Classification:" />
                        <ComboBox
                            Grid.Row="7"
                            Grid.Column="1"
                            ItemsSource="{x:Bind ViewModel.PlantClassifications}"
                            SelectedValue="{x:Bind ViewModel.SelectedPlantClassification, Mode=TwoWay}"
                            Style="{StaticResource AttributeComboxValueStyle}" />


                        <!--  SelectedPhylum  -->
                        <TextBlock
                            Grid.Row="8"
                            VerticalAlignment="Center"
                            Style="{StaticResource DefaultTextBoxStyle}"
                            Text="Phylum:" />
                        <ComboBox
                            Grid.Row="8"
                            Grid.Column="1"
                            ItemsSource="{x:Bind ViewModel.Phyla}"
                            SelectedValue="{x:Bind ViewModel.SelectedPhylum, Mode=TwoWay}"
                            Style="{StaticResource AttributeComboxValueStyle}" />


                    </Grid>


                    <!--  Plant Care title section  -->
                    <StackPanel Orientation="Horizontal">

                        <SymbolIcon Margin="8" Symbol="Edit" />
                        <TextBlock
                            Margin="8"
                            Style="{StaticResource SubheaderTextBlockStyle}"
                            Text="Plant Care" />

                    </StackPanel>


                    <!--  GRID2:  Plant Care  -->
                    <Grid
                        Margin="4,0,4,8"
                        BorderBrush="{ThemeResource SystemAccentColor}"
                        BorderThickness="0,1,0,1"
                        IsHitTestVisible="True">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <!--  Light  -->
                            <RowDefinition Height="Auto" />
                            <!--  Water  -->
                            <RowDefinition Height="Auto" />
                            <!--  Soil  -->
                            <RowDefinition Height="Auto" />
                            <!--  Fertilization Method  -->
                            <RowDefinition Height="Auto" />
                            <!--  Trimming Instructions  -->
                            <RowDefinition Height="Auto" />
                            <!--  Trimming Period  -->
                            <RowDefinition Height="Auto" />
                            <!--  Temperature Minimum  -->
                            <RowDefinition Height="Auto" />
                            <!--  Temperature Maximum  -->
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Light  -->
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource DefaultTextBoxStyle}"
                            Text="Light:" />
                        <TextBox
                            Grid.Column="1"
                            Style="{StaticResource AttributeValueStyle}"
                            Text="{x:Bind ViewModel.ItemLight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!--  Water  -->
                        <TextBlock
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource DefaultTextBoxStyle}"
                            Text="Water:" />
                        <TextBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource AttributeValueStyle}"
                            Text="{x:Bind ViewModel.ItemWater, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!--  Soil  -->
                        <TextBlock
                            Grid.Row="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource DefaultTextBoxStyle}"
                            Text="Soil:" />
                        <TextBox
                            Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource AttributeValueStyle}"
                            Text="{x:Bind ViewModel.ItemSoil, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!--  Fertilization Method  -->
                        <TextBlock
                            Grid.Row="3"
                            VerticalAlignment="Center"
                            Style="{StaticResource DefaultTextBoxStyle}"
                            Text="Fertilization Method:" />
                        <TextBox
                            Grid.Row="3"
                            Grid.Column="1"
                            Style="{StaticResource AttributeValueStyle}"
                            Text="{x:Bind ViewModel.ItemFertilizationMethod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!--  Trimming Instructions  -->
                        <TextBlock
                            Grid.Row="4"
                            VerticalAlignment="Center"
                            Style="{StaticResource DefaultTextBoxStyle}"
                            Text="Trimming Instructions:"
                            TextWrapping="Wrap" />
                        <TextBox
                            Grid.Row="4"
                            Grid.Column="1"
                            Style="{StaticResource AttributeValueStyle}"
                            Text="{x:Bind ViewModel.ItemTrimmingInstructions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />

                        <!--  Trimming Period  -->
                        <TextBlock
                            Grid.Row="5"
                            VerticalAlignment="Center"
                            Style="{StaticResource DefaultTextBoxStyle}"
                            Text="Trimming Period:" />
                        <TextBox
                            Grid.Row="5"
                            Grid.Column="1"
                            Style="{StaticResource AttributeValueStyle}"
                            Text="{x:Bind ViewModel.ItemTrimmingPeriod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!--  Temperature Minimum  -->
                        <TextBlock
                            Grid.Row="6"
                            VerticalAlignment="Center"
                            Style="{StaticResource DefaultTextBoxStyle}"
                            Text="Temperature Minimum:" />
                        <TextBox
                            Grid.Row="6"
                            Grid.Column="1"
                            Style="{StaticResource AttributeValueStyle}"
                            Text="{x:Bind ViewModel.ItemTemperatureRangeMinimum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!--  Temperature Maximum  -->
                        <TextBlock
                            Grid.Row="7"
                            VerticalAlignment="Center"
                            Style="{StaticResource DefaultTextBoxStyle}"
                            Text="Temperature Maximum:" />
                        <TextBox
                            Grid.Row="7"
                            Grid.Column="1"
                            Style="{StaticResource AttributeValueStyle}"
                            Text="{x:Bind ViewModel.ItemTemperatureRangeMaximum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    </Grid>




                    <!--  Plant details title section  -->
                    <StackPanel Orientation="Horizontal">

                        <SymbolIcon Margin="8" Symbol="Edit" />
                        <TextBlock
                            Margin="8"
                            Style="{StaticResource SubheaderTextBlockStyle}"
                            Text="Plant Details" />

                    </StackPanel>


                    <!--  GRID3 Plant details  -->
                    <Grid
                        Margin="4,0,4,8"
                        BorderBrush="{ThemeResource SystemAccentColor}"
                        BorderThickness="0,1,0,1"
                        IsHitTestVisible="True">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <!--  Is Eatable  -->
                            <RowDefinition Height="Auto" />
                            <!--  Color  -->
                            <RowDefinition Height="Auto" />
                            <!--  Flowers  -->
                            <RowDefinition Height="Auto" />
                            <!--  Evergreen  -->
                            <RowDefinition Height="Auto" />
                            <!--  Is Poisonous  -->
                            <RowDefinition Height="Auto" />
                            <!--  Shape  -->
                            <RowDefinition Height="Auto" />
                            <!--  Full Grown Height  -->
                            <RowDefinition Height="Auto" />
                            <!--  Full Grown Width  -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Is Eatable  -->
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource DefaultTextBoxStyle}"
                            Text="Is Eatable:" />
                        <TextBox
                            Grid.Column="1"
                            Style="{StaticResource AttributeValueStyle}"
                            Text="{x:Bind ViewModel.ItemIsEatable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!--  Color  -->
                        <TextBlock
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource DefaultTextBoxStyle}"
                            Text="Color:" />
                        <TextBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource AttributeValueStyle}"
                            Text="{x:Bind ViewModel.ItemColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!--  Flowers  -->
                        <TextBlock
                            Grid.Row="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource DefaultTextBoxStyle}"
                            Text="Flowers:" />
                        <TextBox
                            Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource AttributeValueStyle}"
                            Text="{x:Bind ViewModel.ItemIsFlowering, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!--  Evergreen  -->
                        <TextBlock
                            Grid.Row="3"
                            VerticalAlignment="Center"
                            Style="{StaticResource DefaultTextBoxStyle}"
                            Text="Evergreen:" />
                        <TextBox
                            Grid.Row="3"
                            Grid.Column="1"
                            Style="{StaticResource AttributeValueStyle}"
                            Text="{x:Bind ViewModel.ItemIsEvergreen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!--  Is Poisonous  -->
                        <TextBlock
                            Grid.Row="4"
                            VerticalAlignment="Center"
                            Style="{StaticResource DefaultTextBoxStyle}"
                            Text="Is Poisonous:" />
                        <TextBox
                            Grid.Row="4"
                            Grid.Column="1"
                            Style="{StaticResource AttributeValueStyle}"
                            Text="{x:Bind ViewModel.ItemIsPoisonous, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!--  Shape  -->
                        <TextBlock
                            Grid.Row="5"
                            VerticalAlignment="Center"
                            Style="{StaticResource DefaultTextBoxStyle}"
                            Text="Shape:" />
                        <TextBox
                            Grid.Row="5"
                            Grid.Column="1"
                            Style="{StaticResource AttributeValueStyle}"
                            Text="{x:Bind ViewModel.ItemShape, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!--  Full Grown Height  -->
                        <TextBlock
                            Grid.Row="6"
                            VerticalAlignment="Center"
                            Style="{StaticResource DefaultTextBoxStyle}"
                            Text="Full Grown Height:" />
                        <TextBox
                            Grid.Row="6"
                            Grid.Column="1"
                            Style="{StaticResource AttributeValueStyle}"
                            Text="{x:Bind ViewModel.ItemFullGrownHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!--  Full Grown Width  -->
                        <TextBlock
                            Grid.Row="7"
                            VerticalAlignment="Center"
                            Style="{StaticResource DefaultTextBoxStyle}"
                            Text="Full Grown Width:" />
                        <TextBox
                            Grid.Row="7"
                            Grid.Column="1"
                            Style="{StaticResource AttributeValueStyle}"
                            Text="{x:Bind ViewModel.ItemFullGrownWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    </Grid>



                </StackPanel>



                <StackPanel
                    Grid.Row="2"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal">

                    <!--  implementation of a split button that will allow the user to save and item and return, or save and add another item  -->
                    <SplitButton
                        x:Name="SaveButton"
                        Margin="8,8,0,8"
                        Click="{x:Bind ViewModel.SaveItemAndReturnAsync}"
                        Content="Save and Return"
                        IsEnabled="{x:Bind ViewModel.IsDirty, Mode=OneWay}">

                        <SplitButton.Flyout>

                            <Flyout>

                                <!--  NOTE - we need a stackpanel to hold the buttons even in a flyout  -->
                                <StackPanel>

                                    <!--  button to save and create a new item  -->
                                    <Button
                                        x:Name="SaveAndCreateNew"
                                        Background="Transparent"
                                        Click="{x:Bind ViewModel.SaveItemAndContinueAsync}"
                                        Content="Save and Create New"
                                        IsEnabled="{x:Bind ViewModel.IsDirty, Mode=OneWay}" />

                                    <!--  second button to cancel the save and return  -->
                                    <Button
                                        x:Name="CancelSaveAndReturn"
                                        Background="Transparent"
                                        Click="{x:Bind ViewModel.SaveItemAndReturnAsync}"
                                        Content="Save and Return"
                                        IsEnabled="{x:Bind ViewModel.IsDirty, Mode=OneWay}" />

                                </StackPanel>

                            </Flyout>

                        </SplitButton.Flyout>

                        <SplitButton.Resources>
                            <TeachingTip
                                x:Name="SavingTip"
                                Title="Save and create new"
                                Subtitle="Use the dropdown button option to save your item and create another."
                                Target="{x:Bind SaveButton}" />
                        </SplitButton.Resources>

                    </SplitButton>


                    <!--<Button Content="Save" Margin="8,8,0,8" Command="{x:Bind ViewModel.SaveCommand}"/>-->
                    <Button
                        Margin="8"
                        Command="{x:Bind ViewModel.CancelCommand}"
                        Content="Cancel" />

                    <Button
                        Margin="8"
                        Command="{x:Bind ViewModel.ImportImageCommand}"
                        Content="Import Image" />

                    <Button
                        Margin="8"
                        Command="{x:Bind ViewModel.ShowImageCommand}"
                        Content="Show Images" />


                    <Button
                        Margin="8"
                        Command="{x:Bind ViewModel.OpenPlantProblemsPageCommand}"
                        Content="Show Plant Problems" />

                </StackPanel>



            </Grid>


            <!--  Plant details title section  -->
            <StackPanel Orientation="Vertical">

                <TextBlock
                    Margin="8"
                    Style="{StaticResource SubheaderTextBlockStyle}"
                    Text="Plant Images" />


                <GridView
                    Margin="12"
                    HorizontalAlignment="Stretch"
                    IsItemClickEnabled="True"
                    ItemsSource="{x:Bind ViewModel.SelectedPlantImages, Mode=OneWay}"
                    SelectionMode="Single">

                    <!--  Setup for container  -->
                    <GridView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                            <Setter Property="Margin" Value="5,5,5,5" />
                        </Style>
                    </GridView.ItemContainerStyle>

                    <!--
                        An extra property also needs to be added to the GridView's ItemsWrapGrid.
                        The following sets the maximum # of items to show before wrapping.
                    -->
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid
                                x:Name="MaxItemsWrapGrid"
                                MaximumRowsOrColumns="2"
                                Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>

                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Image
                                Width="300"
                                Height="300"
                                Source="{Binding}"
                                Stretch="UniformToFill" />
                        </DataTemplate>

                    </GridView.ItemTemplate>

                </GridView>


            </StackPanel>


        </StackPanel>


    </ScrollViewer>


</Page>
