<Page
    x:Class="PlantGuessingGame.Views.PlantDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PlantGuessingGame.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:PlantGuessingGame.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    
    
    <Page.Resources>
        <!--  Define some styles for the grid and text blocks  -->
        <Style x:Key="AttributeTitleStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="AttributeValueStyle" TargetType="TextBox">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="8" />
        </Style>
    </Page.Resources>

    
    
    <Grid Margin="10">

        <!--  Title Section  -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--title for page in a stackpanel with a symbol icon and a textblock-->
        <StackPanel Orientation="Horizontal">
            <SymbolIcon Symbol="Edit" Margin="8"/>
            <TextBlock Text="Plant Details" Style="{StaticResource SubheaderTextBlockStyle}" Margin="8"/>
        </StackPanel>

        <!--  Plant Details Section  -->
        <Grid Grid.Row="1" BorderBrush="{ThemeResource SystemAccentColor}" BorderThickness="0,1,0,1" Margin="4,0,4,8">

             
            <!-- grid definitions for the details of the selected plant -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  commons name - note that these have update source triggers via the bindable base -->
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource AttributeTitleStyle}"
                Text="Family:" />
            <TextBox
                Grid.Column="1"
                IsReadOnly="True"
                Style="{StaticResource AttributeValueStyle}"
                Text="{x:Bind ViewModel.ItemCommonName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <!--  plant type  -->
            <TextBlock
                Grid.Row="1"
                VerticalAlignment="Center"
                Style="{StaticResource AttributeTitleStyle}"
                Text="Type:" />
            <TextBox
                Grid.Row="1"
                Grid.Column="1"
                IsReadOnly="True"
                Style="{StaticResource AttributeValueStyle}"
                Text="{x:Bind ViewModel.SelectedPlantType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <!--  Plant Classification  -->
            <TextBlock
                Grid.Row="2"
                VerticalAlignment="Center"
                Style="{StaticResource AttributeTitleStyle}"
                Text="Classification:" />
            <TextBox
                Grid.Row="2"
                Grid.Column="1"
                IsReadOnly="True"
                Style="{StaticResource AttributeValueStyle}"
                Text="{x:Bind ViewModel.SelectedPlantClassification, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <!--  Common Name  -->
            <TextBlock
                Grid.Row="3"
                VerticalAlignment="Center"
                Style="{StaticResource AttributeTitleStyle}"
                Text="Phylum:" />
            <TextBox
                Grid.Row="3"
                Grid.Column="1"
                IsReadOnly="True"
                Style="{StaticResource AttributeValueStyle}"
                Text="{x:Bind ViewModel.SelectedPhylum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <!--  Description  --><!--
            <TextBlock
                Grid.Row="4"
                VerticalAlignment="Center"
                Style="{StaticResource AttributeTitleStyle}"
                Text="Description:" />
            <TextBox
                Grid.Row="4"
                Grid.Column="1"
                IsReadOnly="True"
                Style="{StaticResource AttributeValueStyle}"
                Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            --><!--  Picture  --><!--
            <TextBlock
                Grid.Row="5"
                VerticalAlignment="Center"
                Style="{StaticResource AttributeTitleStyle}"
                Text="Picture:" />
            <TextBox
                Grid.Row="5"
                Grid.Column="1"
                IsReadOnly="True"
                Style="{StaticResource AttributeValueStyle}"
                Text="{x:Bind ViewModel.ImagePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />-->
        </Grid>

        <!--  Button to navigate or save  -->
        <StackPanel
            Grid.Row="6"
            HorizontalAlignment="Right"
            Orientation="Horizontal">

            <Button
                Margin="8"
                Command="{x:Bind ViewModel.NavigateBackCommand}"
                Content="Back" />
        </StackPanel>
        
    </Grid>
</Page>
