<Page
    x:Class="PlantGuessingGame.Views.PlantDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PlantGuessingGame.Views"
    xmlns:viewModels="using:PlantGuessingGame.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Define some styles for the grid and text blocks -->
        <Style x:Key="AttributeTitleStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="AttributeValueStyle" TargetType="TextBox">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="8" />
        </Style>
    </Page.Resources>

    <Grid Margin="10">

        <!-- Title Section -->
        <StackPanel Orientation="Horizontal" Margin="8">
            <SymbolIcon Symbol="Edit" Margin="8"/>
            <TextBlock Text="Plant Details" Style="{StaticResource SubheaderTextBlockStyle}" Margin="8"/>
        </StackPanel>

        <!-- Plant Details Section -->
        <Grid Margin="4,0,4,8" BorderBrush="{ThemeResource SystemAccentColor}" BorderThickness="0,1,0,1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Family -->
            <TextBlock Style="{StaticResource AttributeTitleStyle}" Text="Family:" VerticalAlignment="Center"/>
            <TextBox
                Grid.Column="1"
                Style="{StaticResource AttributeValueStyle}"
                Text="{x:Bind ViewModel.SelectedPlant.FamilyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                IsReadOnly="True"/>

            <!-- Genus -->
            <TextBlock Grid.Row="1" Style="{StaticResource AttributeTitleStyle}" Text="Genus:" VerticalAlignment="Center"/>
            <TextBox
                Grid.Row="1"
                Grid.Column="1"
                Style="{StaticResource AttributeValueStyle}"
                Text="{x:Bind ViewModel.SelectedPlant.Genus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                IsReadOnly="True"/>

            <!-- Species -->
            <TextBlock Grid.Row="2" Style="{StaticResource AttributeTitleStyle}" Text="Species:" VerticalAlignment="Center"/>
            <TextBox
                Grid.Row="2"
                Grid.Column="1"
                Style="{StaticResource AttributeValueStyle}"
                Text="{x:Bind ViewModel.SelectedPlant.Species, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                IsReadOnly="True"/>

            <!-- Common Name -->
            <TextBlock Grid.Row="3" Style="{StaticResource AttributeTitleStyle}" Text="Common Name:" VerticalAlignment="Center"/>
            <TextBox
                Grid.Row="3"
                Grid.Column="1"
                Style="{StaticResource AttributeValueStyle}"
                Text="{x:Bind ViewModel.SelectedPlant.CommonName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                IsReadOnly="True"/>

            <!-- Description -->
            <TextBlock Grid.Row="4" Style="{StaticResource AttributeTitleStyle}" Text="Description:" VerticalAlignment="Center"/>
            <TextBox
                Grid.Row="4"
                Grid.Column="1"
                Style="{StaticResource AttributeValueStyle}"
                Text="{x:Bind ViewModel.SelectedPlant.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                IsReadOnly="True"/>

            <!-- Picture -->
            <TextBlock Grid.Row="5" Style="{StaticResource AttributeTitleStyle}" Text="Picture:" VerticalAlignment="Center"/>
            <TextBox
                Grid.Row="5"
                Grid.Column="1"
                Style="{StaticResource AttributeValueStyle}"
                Text="{x:Bind ViewModel.SelectedPlant.Picture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                IsReadOnly="True"/>
        </Grid>

        <!-- Button to navigate or save -->
        <StackPanel
            Grid.Row="6"
            HorizontalAlignment="Right"
            Orientation="Horizontal">

            <Button
                Margin="8"
                Content="Back"
                Command="{x:Bind ViewModel.NavigateBackCommand}"/>
        </StackPanel>
    </Grid>
</Page>
